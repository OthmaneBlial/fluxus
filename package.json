{
  "name": "@othmaneblial/fluxus",
  "version": "0.1.0",
  "description": "A small framework-independent state store with explicit actions and reducers",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "yarn type-check && tsup",
    "test": "vitest run",
    "test:package": "node test/consumer/check-package.mjs",
    "test:watch": "vitest",
    "lint": "eslint src test bench tsup.config.ts vitest.config.mts eslint.config.cjs",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "verify": "yarn lint && yarn type-check && yarn test && yarn build && yarn test:package",
    "prepack": "yarn build"
  },
  "keywords": [
    "state management",
    "flux",
    "framework-independent"
  ],
  "author": "Othmane BLIAL",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.9.0",
    "@types/node": "^22.4.2",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@typescript-eslint/parser": "^8.2.0",
    "eslint": "^9.9.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OthmaneBlial/fluxus.git"
  }
}
