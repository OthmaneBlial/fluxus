{
  "name": "@othmaneblial/fluxus",
  "version": "0.1.1",
  "description": "A small framework-independent state store with explicit actions and reducers",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "yarn type-check && node scripts/build.mjs",
    "benchmark": "yarn build && node bench/run.mjs",
    "release:check": "node scripts/release-check.mjs",
    "docs:links": "node scripts/check-doc-links.mjs",
    "test": "vitest run",
    "test:package": "node test/consumer/check-package.mjs",
    "test:watch": "vitest",
    "lint": "eslint src test bench scripts examples/*.js vitest.config.mts eslint.config.cjs",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "verify": "yarn lint && yarn docs:links && yarn type-check && yarn test && yarn build && yarn test:package",
    "prepack": "yarn build"
  },
  "keywords": [
    "state management",
    "flux",
    "framework-independent"
  ],
  "author": "Othmane BLIAL",
  "license": "MIT",
  "resolutions": {
    "dts-bundle-generator/typescript": "5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@reduxjs/toolkit": "2.12.0",
    "@types/node": "22.20.4",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.1",
    "dts-bundle-generator": "9.5.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "zustand": "5.0.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OthmaneBlial/fluxus.git"
  }
}
